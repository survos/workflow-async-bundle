{
    "name": "survos/workflow-packages-example",
    "description": "Two queued native workflow transitions: package metadata and README",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "survos/workflow-messenger-bundle": "^0.1@dev",
        "survos/workflow-extras-bundle": "^0.1@dev",
        "survos/kit-bundle": "^2.5@dev",
        "symfony/console": "8.2.*@dev",
        "symfony/http-client": "8.2.*@dev",
        "symfony/event-dispatcher": "8.2.*@dev",
        "composer/semver": "^3.4",
        "composer/metadata-minifier": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true,
                "versions": {
                    "survos/workflow-messenger-bundle": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../../workflow-extras-bundle",
            "options": {
                "symlink": true,
                "versions": {
                    "survos/workflow-extras-bundle": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../../kit-bundle",
            "options": {
                "symlink": true,
                "versions": {
                    "survos/kit-bundle": "2.5.x-dev"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Survos\\WorkflowExample\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\WorkflowExample\\Tests\\": "tests/",
            "Survos\\WorkflowMessengerBundle\\Tests\\": "../../tests/",
            "Survos\\WorkflowExtrasBundle\\Tests\\": "../../../workflow-extras-bundle/tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": false
    },
    "scripts": {
        "test": "phpunit"
    }
}
