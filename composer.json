{
    "name": "survos/workflow-messenger-bundle",
    "description": "Queued native Symfony workflow transitions through Messenger",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "workflow",
        "messenger",
        "async"
    ],
    "require": {
        "php": "^8.5",
        "survos/kit-bundle": "^2.5",
        "symfony/config": "8.2.*@dev",
        "symfony/dependency-injection": "8.2.*@dev",
        "symfony/http-kernel": "8.2.*@dev",
        "symfony/workflow": "8.2.*@dev",
        "psr/container": "^2.0",
        "symfony/event-dispatcher": "8.2.*@dev",
        "symfony/messenger": "8.2.*@dev",
        "symfony/service-contracts": "^3.8",
        "survos/workflow-extras-bundle": "^0.1@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Survos\\WorkflowMessengerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\WorkflowMessengerBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
